{
  "name": "ask-eternus-functions",
  "private": true,
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build-kb": "node scripts/build-kb.mjs",
    "check-kb": "node ../checks/check-kb.mjs",
    "test": "node scripts/build-kb.mjs && node --test \"test/unit/*.test.js\"",
    "test:emulator": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-ask-eternus \"node --test test/emulator/*.test.js\""
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "google-auth-library": "11.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  }
}
