{
  "functions": [
    {
      "source": "functions",
      "codebase": "ask-eternus",
      "runtime": "nodejs22",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build-kb"],
      "ignore": ["node_modules", "test", "scripts", ".git", "*.log", ".env*"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": { "port": 8080 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
